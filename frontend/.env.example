# Backend API base. Used by the Next.js server-side rewrite (next.config) to
# proxy /api/* to the real backend. The browser itself always calls /api so
# auth cookies stay first-party (fixes iOS/Safari ITP).
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
# Google sign-in: OAuth client id (same as the backend GOOGLE_CLIENT_ID). Leave empty to hide the button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Cloudflare Turnstile site key (CAPTCHA on checkout). Leave empty to hide the
# widget; the backend skips the check while TURNSTILE_SECRET_KEY is empty.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
