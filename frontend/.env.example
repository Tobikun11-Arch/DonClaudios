# Backend API base. Used by the Next.js server-side rewrite (next.config) to
# proxy /api/* to the real backend. The browser itself always calls /api so
# auth cookies stay first-party (fixes iOS/Safari ITP).
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here