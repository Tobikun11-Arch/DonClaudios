# Server
PORT=
NODE_ENV=

# Auth
JWT_SECRET=
JWT_REFRESH_SECRET=

# Database
MONGO_URI=

# Review word filter
# Set to false to disable automatic bad-word filtering of customer reviews.
# The word lists live in api/utils/profanityWords.ts
PROFANITY_FILTER_ENABLED=true

#Email info 
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SMS
IPROG_SMS_API_TOKEN=your_api_token
IPROG_SMS_API_BASE_URL=https://www.iprogsms.com/api/v1
IPROG_SMS_PROVIDER=2
GUEST_OTP_CODE_MINUTES=5
GUEST_OTP_VERIFIED_DAYS=30

# Cloudinary  
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=  

# Cookies
# COOKIE_SECURE: true in production (HTTPS). COOKIE_SAMESITE: 'lax' or 'none'
# (never 'strict' — drops cookies on top-level navigations from email links).
COOKIE_SECURE=
COOKIE_SAMESITE=

# Web Push (VAPID) - generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com

# Xendit payment gateway (test keys start with xnd_development_)
# Dashboard -> Settings -> API Keys (secret key, needs Money-in write + Refund write)
XENDIT_SECRET_KEY=
# Dashboard -> Settings -> Webhooks -> "Verification token"
XENDIT_WEBHOOK_TOKEN=
XENDIT_API_BASE_URL=https://api.xendit.co
# Public URL of the frontend, used for the redirect after paying
FRONTEND_URL=http://localhost:3000
# How long a customer has to pay after the cashier confirms
PAYMENT_EXPIRY_MINUTES=30
PREORDER_PAYMENT_EXPIRY_HOURS=24
